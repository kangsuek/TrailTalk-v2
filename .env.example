# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 모두 기본값이 있어 비워 둬도 서버는 시작한다. 바꿀 때만 지정한다.

# DATABASE_URL=sqlite+aiosqlite:////절대/경로/trailtalk.db
# LOG_LEVEL=INFO
# AUTO_MIGRATE=true
# IDLE_TIMEOUT_S=1800
# DEFAULT_PERSONA=jenny
# TIMEZONE=Asia/Seoul

# 데이터 폴더(검증용 서버는 모두 임시 경로로 바꾼다)
# CLIENT_DEFAULTS_PATH=
# PERSONA_DIR=
# WEB_DIST_DIR=
# ATTACHMENTS_DIR=
# AUDIO_DIR=
# CLI_WORK_DIR=

# Claude CLI (M1)
# CLAUDE_CLI_PATH=claude
# CLAUDE_CODE_OAUTH_TOKEN=
# CLI_TURN_TIMEOUT_S=120
# LLM_CHAT_MODEL=sonnet
# INTERNAL_BASE_URL=http://127.0.0.1:8000
# CLI_ENV_PASSTHROUGH=

# 음성 인식·합성 (M3). 키가 없어도 서버는 시작하고 음성 호출만 voice_unavailable이다
# OPENAI_API_KEY=
# VOICE_BACKEND=openai        # fake면 과금 없는 가짜(run.sh --fake)
# STT_MODEL=gpt-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# TTS_FALLBACK_MODEL=tts-1
# FFMPEG_PATH=ffmpeg          # ogg 등 변환이 필요한 업로드에만 쓴다

# Claude 앱 MCP 연계 (docs/MCP). 아래 두 값이 있으면 ./run.sh가 외부 MCP 서버(별도 포트)를 자동으로 함께 띄운다(--no-mcp로 끔).
# 공개 주소와 소유자 비밀번호가 없으면 외부 서버는 시작하지 않는다. 값은 저장소에 두지 않는다.
# 형식은 KEY=값 한 줄(앞에 export·공백 없이). run.sh와 서버가 같은 파일을 읽는다.
# MCP_PUBLIC_URL=https://<기기 이름>.<tailnet>.ts.net   # 끝 슬래시·경로 없이, https
# MCP_OWNER_PASSWORD=                                   # 16자 이상, 앱 연결 승인 때 입력
# MCP_PORT=8400
# MCP_ALLOWED_REDIRECTS=                                # 쉼표 구분, 비우면 Claude 콜백 하나
# MCP_MAX_CLIENTS=50
# MCP_CALL_LOG=                                         # 호출 기록(이름·시각·성공·대상 id만)

# 웹 검색 도구 (M5-09). 키 이름만 적는다. 키가 없어도 서버는 시작하고 그 도구는 오류를 돌려주며,
# 모델은 내장 WebSearch로 폴백한다. 값은 저장소에 두지 않는다.
# NAVER_CLIENT_ID=            # NAVER API HUB(NCP API Gateway) Client ID(뉴스 search_naver, 블로그 search_naver_blog)
# NAVER_CLIENT_SECRET=        # 같은 Client Secret. 네이버 개발자센터(openapi.naver.com) 키는 호환되지 않는다
# NAVER_BASE_URL=https://naverapihub.apigw.ntruss.com
# HASDATA_API_KEY=            # HasData 구글 검색 search_google, 웹 스크래핑 search_google_detail
# HASDATA_BASE_URL=https://api.hasdata.com
# HASDATA_SEARCH_PATH=/scrape/google-light/serp/
# HASDATA_SCRAPE_PATH=/scrape/web/
# HASDATA_KEY_HEADER=x-api-key
# HASDATA_SEARCH_TIMEOUT_S=6  # 넘으면 WebSearch로 폴백
# WEB_FETCH_TIMEOUT_S=10      # web_fetch(서버가 직접 읽는 페이지 도구)
# WEB_FETCH_MAX_BYTES=1000000

# 외부 MCP 서버 연결 (M5-12·13, FR-25). 서버 목록은 server/mcp-servers.yaml(server/mcp-servers.example.yaml을
# 복사해 고친다. 이 파일은 커밋하지 않는다)에 두고, 비밀 값은 아래처럼 여기에 둔다. 파일의 env·headers 값에
# ${MCP_<서버>_<이름>}으로 적으면 서버가 이 값을 읽어 CLI 전용 0600 파일에만 쓴다.
# <서버>는 서버 이름을 대문자로, -를 _로 바꾼 것이다. 변수가 없거나 비어 있으면 서버가 시작하지 않는다.
# MCP_SERVERS_PATH=                    # 기본 server/mcp-servers.yaml, 없으면 외부 서버 없음
# MCP_EXAMPLE_SEARCH_API_KEY=          # 예시 서버 example-search의 비밀 변수
